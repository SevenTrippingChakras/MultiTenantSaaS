# Environment: dev | staging | prod. In prod the app refuses to boot with a
# default or too-short JWT_SECRET.
ENV=dev

# MongoDB Atlas connection string
MONGODB_URI=your-mongodb-uri
MONGODB_DB=aichat

# Redis (shared rate-limit storage; readiness check). Use redis://redis:6379/0
# inside docker-compose (service name), redis://localhost:6379/0 for local dev.
REDIS_URI=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=sk-...

# Auth / JWT (must be a long random string in prod, >= 32 chars)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MIN=60

# Comma-separated list of browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173

# Max characters accepted in a single chat message.
MAX_MESSAGE_CHARS=16000

# Rate limits (SlowAPI "N/period" strings). default_ applies to every route;
# the others override it on the hot endpoints. Tunable without a code change.
DEFAULT_RATE_LIMIT=200/minute
AUTH_RATE_LIMIT=10/minute
CHAT_RATE_LIMIT=30/minute
