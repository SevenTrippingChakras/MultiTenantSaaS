# Environment: dev | staging | prod. In prod the app refuses to boot with a
# default or too-short JWT_SECRET.
ENV=dev

# MongoDB Atlas connection string
MONGODB_URI=your-mongodb-uri
MONGODB_DB=aichat
# Connection pool bounds per worker process. maxPoolSize caps concurrent sockets
# (keep total across workers under your Atlas tier's connection limit);
# minPoolSize keeps warm connections so bursts skip handshake latency.
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=0
# Days a soft-deleted session is kept before the purge job (app.jobs.purge)
# reclaims it and its messages.
SOFT_DELETE_RETENTION_DAYS=30

# Redis (shared rate-limit storage; readiness check). Use redis://redis:6379/0
# inside docker-compose (service name), redis://localhost:6379/0 for local dev.
REDIS_URI=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=sk-...

# Auth / JWT (must be a long random string in prod, >= 32 chars)
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MIN=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Refresh-token cookie domain. Leave unset in dev (host-only). In prod set to
# your shared root, e.g. .chatprod.com, so app + api subdomains share it.
# COOKIE_DOMAIN=.chatprod.com

# Comma-separated list of browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173

# Max characters accepted in a single chat message.
MAX_MESSAGE_CHARS=16000

# Rate limits (SlowAPI "N/period" strings). default_ applies to every route;
# the others override it on the hot endpoints. Tunable without a code change.
DEFAULT_RATE_LIMIT=200/minute
AUTH_RATE_LIMIT=10/minute
CHAT_RATE_LIMIT=30/minute

# Stripe billing (Phase 11). Leave the keys empty to disable billing calls
# (the API then rejects checkout/webhook rather than talking to Stripe). Use
# test-mode keys (sk_test_..., whsec_...) for local dev — free, no real charges.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring price ids from the Stripe dashboard, mapped to our plans.
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
# Where Stripe Checkout redirects after success/cancel.
CHECKOUT_SUCCESS_URL=http://localhost:5173/billing/success
CHECKOUT_CANCEL_URL=http://localhost:5173/billing/cancel
